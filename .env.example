# ============================================================
# Wealth Flightpath AI — environment variables
# Copy to .env on the VPS. Never commit real values.
# HTTPS is terminated by Nginx Proxy Manager; the app speaks plain HTTP.
# ============================================================

# --- Server ---
APP_PORT=3000
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# --- Supabase (database, auth, storage) ---
# Server-side
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_PROJECT_ID=your-project-ref

# Client-side (must be prefixed VITE_)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Lovable AI Gateway (statement extraction, coach, reviews) ---
# Issued by Lovable; never expose to the browser.
LOVABLE_API_KEY=

# --- Optional ---
# Override the chat model used by the AI Coach. Defaults to google/gemini-3-flash-preview.
# AI_CHAT_MODEL=google/gemini-3-flash-preview